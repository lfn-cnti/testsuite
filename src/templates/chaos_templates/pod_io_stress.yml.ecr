apiVersion: litmuschaos.io/v1alpha1
kind: ChaosEngine
metadata:
  name: <%= @test_name %>
  namespace: <%= @app_namespace %>
spec:
  engineState: 'active'
  appinfo:
    appns: '<%= @app_namespace %>'
    applabel: '<%= @deployment_label %>=<%= @deployment_label_value %>'
    appkind: '<%= @app_kind %>'
  chaosServiceAccount: <%= @chaos_experiment_name %>-sa
  experiments:
    - name: <%= @chaos_experiment_name %>
      spec:
        components:
          env:
            # set chaos duration (in sec) as desired
            - name: TOTAL_CHAOS_DURATION
              value: '<%= @total_chaos_duration %>'

            ## specify the stress file size as a percentage of the free space
            ## of --temp-path, computed to stay under the target container's
            ## memory limit. The percentage is always non-empty (litmus maps
            ## the literal "0" to its own 10% default) and FILESYSTEM_UTILIZATION_BYTES
            ## stays '0' so litmus never appends the raw bytes as "NG".
            - name: FILESYSTEM_UTILIZATION_PERCENTAGE
              value: '<%= @filesystem_utilization_percentage.empty? ? "50" : @filesystem_utilization_percentage %>'
            - name: FILESYSTEM_UTILIZATION_BYTES
              value: '0'
            <% unless @volume_mount_path.empty? %>
            - name: VOLUME_MOUNT_PATH
              value: '<%= @volume_mount_path %>'
            <% end %>
            - name: TARGET_PODS
              value: '<%= @target_pod_name %>'
            # empty means the pod's first container, which may be read-only
            - name: TARGET_CONTAINER
              value: '<%= @target_container %>'

              ## provide the cluster runtime
            - name: CONTAINER_RUNTIME
              value: '<%= @container_runtime %>'

            # provide the socket file path
            - name: SOCKET_PATH
              value: '<%= @socket_path %>'