apiVersion: litmuschaos.io/v1alpha1
kind: ChaosEngine
metadata:
  name: <%= @test_name %>
  namespace: <%= @app_namespace %>
spec:
  engineState: 'active'
  appinfo:
    appns: '<%= @app_namespace %>'
    applabel: '<%= @deployment_label %>=<%= @deployment_label_value %>'
    appkind: '<%= @app_kind %>'
  chaosServiceAccount: <%= @chaos_experiment_name %>-sa
  experiments:
    - name: <%= @chaos_experiment_name %>
      spec:
        components:
          env:
            # set chaos duration (in sec) as desired
            - name: TOTAL_CHAOS_DURATION
              value: '<%= @total_chaos_duration %>'

            ## specify the size as percentage of free space on the file system
            - name: FILESYSTEM_UTILIZATION_PERCENTAGE
<% if @filesystem_utilization_percentage.empty? %>
              ## The target's root filesystem is not memory backed, so the
              ## default size cannot OOM the CNF and is left to litmus.
              value: '50'
<% else %>
              ## Bounded to what the target has left of its memory limit,
              ## because its root filesystem is a tmpfs and the file is
              ## charged to that limit as shmem.
              value: '<%= @filesystem_utilization_percentage %>'
              ## Empty, not "0": litmus maps FILESYSTEM_UTILIZATION_BYTES to
              ## "NG", whole GiB only, and rejects a sub-GiB value.
            - name: FILESYSTEM_UTILIZATION_BYTES
              value: ''
<% end %>
            - name: TARGET_PODS
              value: '<%= @target_pod_name %>'
            # empty means the pod's first container, which may be read-only
            - name: TARGET_CONTAINER
              value: '<%= @target_container %>'

              ## provide the cluster runtime
            - name: CONTAINER_RUNTIME
              value: '<%= @container_runtime %>'

            # provide the socket file path
            - name: SOCKET_PATH
              value: '<%= @socket_path %>'